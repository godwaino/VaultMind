{
  "name": "vaultmind",
  "private": true,
  "version": "0.0.0",
  "description": "VaultMind — privacy-first personal document intelligence (monorepo root)",
  "workspaces": [
    "packages/*",
    "backend",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty && tsc --noEmit -p backend",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:watch": "NODE_OPTIONS=--experimental-sqlite vitest",
    "lint": "echo \"(eslint config lands with the Expo app in Phase 1)\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@noble/hashes": "^1.6.1",
    "@scure/bip39": "^1.5.0"
  }
}
