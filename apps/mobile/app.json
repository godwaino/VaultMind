{
  "expo": {
    "name": "VaultMind",
    "slug": "vaultmind",
    "scheme": "vaultmind",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.vaultmind.app" },
    "android": { "package": "com.vaultmind.app" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        { "color": "#5b3df5" }
      ]
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "apiBase": ""
    }
  }
}
