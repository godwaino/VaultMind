{
    "//": "Web app TS config. Excluded from the root `tsc -b` graph (needs next/react types installed on a dev machine), exactly like apps/mobile.",
    "compilerOptions": {
          "target": "ES2022",
          "lib": ["ES2022", "DOM", "DOM.Iterable"],
          "module": "ESNext",
          "moduleResolution": "Bundler",
          "jsx": "preserve",
          "strict": true,
          "esModuleInterop": true,
          "skipLibCheck": true,
          "noEmit": true,
          "allowJs": true,
          "incremental": true,
          "resolveJsonModule": true,
          "isolatedModules": true,
          "plugins": [{ "name": "next" }]
    },
    "include": ["app/**/*", "lib/**/*", "next-env.d.ts", "css.d.ts", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
