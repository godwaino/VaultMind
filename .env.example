# VaultMind — environment variables (template)
#
# Copy to `.env` (gitignored) and fill in. Two trust zones:
#   • SERVER-ONLY  → set in Vercel project env. NEVER ship in the app bundle (ADR-004, §5).
#                    The mobile app reaches these services only through the backend proxy.
#   • CLIENT (EXPO_PUBLIC_*) → safe to embed in the app; RLS/secret-less by design.
#
# Nothing secret belongs in any EXPO_PUBLIC_* var.

# ============================================================================
# SERVER-ONLY  (Vercel env)
# ============================================================================

# --- Supabase (Auth + Postgres + Storage) ---------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key: full DB access, bypasses RLS. Server only. Rotate if leaked.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (ContractScan Tier 2) ----------------------------------
# Use the PAID Gemini API or Vertex AI — NOT the free AI Studio tier, which trains
# on submitted data. Enabling Cloud Billing (pay-as-you-go) guarantees no training.
GEMINI_API_KEY=
# Model is config so it can be swapped/A-B'd without an app release (ADR-006).
GEMINI_MODEL=gemini-2.5-pro
# Set true once per-project Zero-Data-Retention is approved for this Gemini project
# (DECISIONS #7). Until then, consent copy must use accurate-disclosure wording.
# NOTE: ZDR is incompatible with Google Search/Maps grounding and explicit context
# caching — keep those OFF for ContractScan.
GEMINI_ZDR_ENABLED=false
#
# If you use Vertex AI instead of the Gemini Developer API, replace GEMINI_API_KEY with:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# (auth via GOOGLE_APPLICATION_CREDENTIALS_JSON below)

# --- Google Cloud Vision (cloud OCR fallback) -----------------------------
# Use ONE of these depending on your auth method:
GOOGLE_VISION_API_KEY=
# or a base64-encoded service-account JSON:
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Paystack (payments) ---------------------------------------------------
# Secret key also signs webhooks (verified in backend/lib/billing/paystack.ts).
PAYSTACK_SECRET_KEY=
# Plan codes drive tier mapping (tierForPlan). Configure your real codes:
PAYSTACK_PLAN_PERSONAL=PLN_xxx_personal
PAYSTACK_PLAN_PERSONAL_EARLY=PLN_xxx_early_access
PAYSTACK_PLAN_FAMILY=PLN_xxx_family

# --- Resend (transactional email: verification, expiry reminders) ---------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@vaultmind.app

# --- SMS OTP (MFA fallback) — pick ONE provider (DECISIONS: Termii vs Twilio) ---
TERMII_API_KEY=
TERMII_SENDER_ID=
# or Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# --- Signing secret for the offline entitlement claim ----------------------
# HMAC secret for backend/lib/billing/claim.ts. Generate: openssl rand -hex 32
ENTITLEMENT_CLAIM_SECRET=

# --- Rate limiting (ARCHITECTURE §4.1: Upstash / Vercel KV) ----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability (optional but recommended) ------------------------------
SENTRY_DSN=

# ============================================================================
# CLIENT  (Expo app — EXPO_PUBLIC_*, safe to embed)
# ============================================================================

# Base URL of the deployed backend the app talks to.
EXPO_PUBLIC_API_BASE_URL=https://api.vaultmind.app

# Supabase anon/publishable key: RLS-protected, intended to be public.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Paystack PUBLIC key for client-side checkout init (the secret stays server-side).
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Sentry (client) — optional.
EXPO_PUBLIC_SENTRY_DSN=
